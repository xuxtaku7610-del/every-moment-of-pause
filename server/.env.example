# 이 파일을 server/.env로 복사해서 쓴다. server/.env는 커밋하지 않는다.

# PostgreSQL (docker compose)
DATABASE_URL=postgresql+psycopg://pause:pause@127.0.0.1:5432/pause

# 한국도로공사 휴게소 API 인증키. 비워 두면 수집 잡이 app/data/sample_reststops.json을 적재한다.
EX_API_KEY=

# 한국관광공사 TourAPI(반려동물 동반여행) 인증키. 비워 두면 app/data/sample_pet_places.json을 적재한다 ("샘플" 표시).
TOUR_API_KEY=

# 동물병원 인허가 파일(server/data/raw/*.csv)의 좌표계. 파일에 위도·경도 열이 있으면 쓰지 않는다.
VET_SOURCE_CRS=EPSG:5174

# Ollama: 네이티브 /api/chat 사용, 요청마다 think=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_KEEP_ALIVE=30m
# 출력 최대 토큰. 모델 상주 상태 실측 2.58초 → 2.5초 목표에 맞추려고 60으로 제한 (temperature는 코드에서 0.3 고정)
OLLAMA_NUM_PREDICT=60
LLM_TIMEOUT_SECONDS=2.5
LLM_MAX_SENTENCES=2
