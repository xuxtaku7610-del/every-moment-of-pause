# 이 파일을 server/.env로 복사해서 쓴다. server/.env는 커밋하지 않는다.

# PostgreSQL (docker compose)
DATABASE_URL=postgresql+psycopg://pause:pause@localhost:5432/pause

# 한국도로공사 휴게소 API 인증키. 비워 두면 수집 잡이 app/data/sample_reststops.json을 적재한다.
EX_API_KEY=

# Ollama: 네이티브 /api/chat 사용, 요청마다 think=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=2.5
LLM_MAX_SENTENCES=2
